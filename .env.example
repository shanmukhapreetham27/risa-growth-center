# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Neon project risa-growth-center (aws-ap-southeast-1). Branch main = demo DB, branch test = tests only.

# main, pooled (host contains -pooler). Used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# main, direct. Migrations and reset only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# main, read only role risa_readonly (SELECT on v_* views only). Used by the copilot query_data tool.
DATABASE_URL_READONLY=postgresql://risa_readonly:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# test branch, direct. Tests only (they reset this database). Must never point at main.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# test branch, read only role risa_readonly. Used by the query_data tests.
DATABASE_URL_READONLY_TEST=postgresql://risa_readonly:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Anthropic Messages API (server side only, never sent to the browser).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
